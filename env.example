# ─────────────────────────────────────────────────────────────────────
#  sistema-vinculo — environment template
#
#  Copy to .env at the REPO ROOT:   cp env.example .env
#  Every app (web, worker) and Prisma read this single file via dotenv.
#  Keep it UTF-8 without BOM. Never commit the real .env.
#
#  Legend:  [req] required to boot · [pay] required for real payments ·
#           [opt] optional (feature stays off / degrades gracefully)
#  The values below are a working LOCAL setup.
# ─────────────────────────────────────────────────────────────────────


# ── Core ────────────────────────────────────────────────────────────
# (do NOT set NODE_ENV here — Next/tsx manage it per command)

# [req] Postgres. Local Docker: point both at the same URL.
#   Neon: DATABASE_URL = pooled endpoint (host contains "-pooler"), append:
#     ?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1&pool_timeout=20&connect_timeout=15
#   so Prisma keeps one short-lived connection through Neon's PgBouncer
#   instead of idle sockets Neon keeps resetting (ConnectionReset spam).
#   DIRECT_URL = direct endpoint (no "-pooler"), used by `prisma migrate` —
#   keep it WITHOUT the pgbouncer/connection_limit params. Falls back to
#   DATABASE_URL when unset (fine for local Docker Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/donation?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/donation?schema=public

# [req] Redis. Local: redis://localhost:6379
#   Upstash: use the rediss:// URL (TLS). Free tier is metered — stop the
#   worker when idle, or raise WORKER_DRAIN_DELAY.
REDIS_URL=redis://localhost:6379

# [opt] Seconds the worker waits before draining a queue on shutdown.
# WORKER_DRAIN_DELAY=30

# [opt] "on" pins Postgres RLS in tenantPrisma — only after applying
#   packages/db/sql/rls.sql. Leave "off" until then.
DB_RLS=off


# ── Auth (Auth.js / NextAuth v5) ────────────────────────────────────

# [req] Session/JWT signing secret (min 16 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=l/zNeVthongjVfz3NInkV0FK7fUZJmLuacVO+SM4fjc=

# [req] Canonical origin of the PANEL. Must match the host you open and
#   the scheme (http locally). The panel lives on the app.<domain> host.
#   Local dev:   http://app.localhost:3000
#   Production:  https://app.suaplataforma.com.br
NEXTAUTH_URL=http://app.localhost:3000

# [opt] Google sign-in. Blank hides the "Continuar com Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Domains / tenancy ──────────────────────────────────────────────

# [req] Base domain for host-based routing:
#   app.<base>      → /panel/*      (dashboard)
#   admin.<base>    → /admin/*      (platform back-office)
#   <slug>.<base>   → public campaign sites  (+ custom domains)
#   Local dev:   localhost:3000     (*.localhost resolves automatically)
#   Production:  suaplataforma.com.br
APP_BASE_DOMAIN=localhost:3000

# [opt] Public base used in shareable links when the app runs behind a
#   proxy on a different port/host. e.g. APP_BASE_DOMAIN=suaong.com:3305
#   with PUBLIC_APP_BASE_DOMAIN=suaong.com. Blank → use APP_BASE_DOMAIN.
PUBLIC_APP_BASE_DOMAIN=

# [opt] Absolute base for the marketing site's canonical/OG/robots/sitemap
#   links. No trailing slash.
#   Local: http://localhost:3000   Production: https://www.suaplataforma.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [opt] Public origin inbound provider webhooks must reach. In dev, a
#   tunnel (cloudflared / ngrok); in prod, the real domain. No trailing
#   slash. Blank → the Pagamentos page derives it from the request host.
PUBLIC_WEBHOOK_BASE_URL=


# ── Payments ───────────────────────────────────────────────────────

# [pay] 32-byte base64 key that encrypts each org's connected gateway
#   secret at rest (BYOG). Required for any real card/Pix/boleto flow.
#   Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Rotating this invalidates every stored gateway key — do it deliberately.
PAYMENTS_ENC_KEY=

# [opt] "mock" = in-process fake gateway for local dev / E2E (no Pagar.me):
#   - card approves instantly; tokens starting with "decline"/"fail" fail
#   - Pix / boleto stay "pending" — confirm with:
#       POST http://localhost:3000/api/dev/pay   { "donationId": "..." }
#   - any org can receive without connecting an account
#   Blank → real gateway (each org connects its own Pagar.me account).
PAYMENTS_GATEWAY=

# [opt] Pagar.me v5 — ONLY for the MANAGED (facilitator + split) model.
#   Pure BYOG deploy → leave all blank; orgs connect their own keys in-app.
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=
PLATFORM_RECIPIENT_ID=


# ── International donations (Stripe) — optional ────────────────────
# [opt] Blank → the international checkout stays hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── Object storage (S3 / R2 / MinIO) — optional ───────────────────
# [opt] Blank → KYC uploads and CSV export downloads are disabled.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto


# ── Platform back-office ──────────────────────────────────────────
# [opt] Comma-separated e-mails allowed into admin.<domain>. The seed
#   creates owner@demo.test.
PLATFORM_ADMIN_EMAILS=owner@demo.test


# ── E-mail (Resend) — optional ───────────────────────────────────
# [opt] Blank → e-mails are logged to the console instead of sent
#   (recommended for local dev — no quota burn, no real inboxes hit).
RESEND_API_KEY=

# [opt] Verified sending domain in Resend (SPF+DKIM+DMARC). The address
#   becomes no-reply@<this>. EMAIL_FROM is the display "From".
EMAIL_SENDING_DOMAIN=
EMAIL_FROM=Doações <no-reply@example.com>

# [opt] Resend (Svix) webhook signing secret — bounce/complaint handling
#   feeds the suppression list. In production the webhook fails closed
#   without it. Get it in the Resend panel when creating the webhook.
RESEND_WEBHOOK_SECRET=


# ── Observability — optional ─────────────────────────────────────
SENTRY_DSN=


# ── Production supervisor (scripts/start-prod.mjs) ───────────────
# [opt] Port for `pnpm start:prod` (defaults to 3305). `pnpm dev` always
#   uses 3000. When you run start:prod, NEXTAUTH_URL / APP_BASE_DOMAIN
#   must use this port.
# PORT=3305
