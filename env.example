# Copy to .env at the REPO ROOT:  cp env.example .env
# Every app (web, worker) and Prisma read this single file.

# ── Core ────────────────────────────────────────────
# (do NOT set NODE_ENV here — Next/tsx manage it per command)

# Postgres. Local Docker: set both to the same URL.
# Neon: DATABASE_URL = pooled endpoint (host has "-pooler"). Append these params
#       so Prisma keeps a single, short-lived connection through Neon's PgBouncer
#       instead of a pool of idle sockets Neon keeps resetting (error 10054 /
#       "Error in PostgreSQL connection: ConnectionReset" spam in `next dev`):
#         ?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1&pool_timeout=20&connect_timeout=15
#       DIRECT_URL    = direct endpoint (no "-pooler"), used by `prisma migrate`
#                       — keep it WITHOUT pgbouncer/connection_limit params.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/donation?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/donation?schema=public

# Redis. Local: redis://localhost:6379
# Upstash: use the rediss:// URL (TLS). Free tier is metered — stop the worker
# when not testing, or set WORKER_DRAIN_DELAY higher.
REDIS_URL=redis://localhost:6379
# WORKER_DRAIN_DELAY=30

# "on" enables Postgres RLS pinning — only after applying packages/db/sql/rls.sql
DB_RLS=off

# ── Auth (Auth.js) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://app.localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Domains / tenancy ───────────────────────────────
APP_BASE_DOMAIN=localhost:3000

# Origem pública que os webhooks dos provedores devem acessar (túnel no dev,
# domínio real em produção). Sem barra no fim. Deixe em branco para a página de
# Pagamentos deduzir pelo host da requisição.
#   ex.: PUBLIC_WEBHOOK_BASE_URL=https://development.ordfy.com.br
PUBLIC_WEBHOOK_BASE_URL=

# ── Pagamentos — chave para cifrar as chaves de gateway conectadas (BYOG) ──
# Obrigatória. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENTS_ENC_KEY=

# ── Gateway de pagamento ────────────────────────────
# "mock" = gateway falso em processo, para dev local / E2E (sem Pagar.me).
#   - cartão aprova na hora; Pix/boleto ficam "pendente"
#   - confirme um Pix/boleto com:  POST /api/dev/pay  { "donationId": "..." }
#   - qualquer ONG fica apta a receber, sem conectar conta
# Deixe em branco para usar o gateway real.
PAYMENTS_GATEWAY=

# ── Pagar.me v5 — SÓ para o plano GERENCIADO (facilitador + split) ──
# Num deploy 100% BYOG (cada org conecta a própria conta em Pagamentos), pode deixar em branco.
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=
PLATFORM_RECIPIENT_ID=

# ── Doação internacional (Stripe) — OPCIONAL ────────
# Deixe em branco para esconder o checkout internacional.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Storage (S3 / R2 / MinIO) — OPTIONAL ────────────
# Leave blank to run without KYC uploads / CSV export downloads.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Platform back-office ────────────────────────────
PLATFORM_ADMIN_EMAILS=owner@demo.test

# ── E-mail (optional — logs to console without a key) ──
RESEND_API_KEY=
EMAIL_FROM=Doações <no-reply@example.com>
# Domínio de envio verificado no Resend (SPF+DKIM+DMARC). O endereço vira
# no-reply@<este>. Recomendado separar streams: recibos.<dominio> e novidades.<dominio>.
EMAIL_SENDING_DOMAIN=
# Segredo do webhook do Resend (bounces / reclamações → lista de supressão).
RESEND_WEBHOOK_SECRET=

# ── Observability ───────────────────────────────────
SENTRY_DSN=
