{
  "name": "@donation/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "rls:apply": "dotenv -e ../../.env -- prisma db execute --file ./sql/rls.sql --schema ./prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:showcase": "dotenv -e ../../.env -- tsx prisma/seed-showcase.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@donation/shared": "workspace:*",
    "@donation/payments": "workspace:*",
    "@donation/emails": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^7.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
