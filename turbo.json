{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "DB_RLS",
    "NODE_ENV",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "APP_BASE_DOMAIN",
    "PUBLIC_WEBHOOK_BASE_URL",
    "PAYMENTS_GATEWAY",
    "PAGARME_SECRET_KEY",
    "PAGARME_PUBLIC_KEY",
    "PAGARME_WEBHOOK_SECRET",
    "PLATFORM_RECIPIENT_ID",
    "PAYMENTS_ENC_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_REGION",
    "PLATFORM_ADMIN_EMAILS",
    "RESEND_API_KEY",
    "EMAIL_SENDING_DOMAIN",
    "RESEND_WEBHOOK_SECRET",
    "SENTRY_DSN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
